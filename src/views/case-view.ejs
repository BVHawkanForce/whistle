<!DOCTYPE html>
<html lang="<%= i18n.language %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= t('case_details') %> - <%= report.title %></title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <div class="container">
        <div class="lang-switcher">
            <a href="?lng=en">English</a> | <a href="?lng=sv">Svenska</a> | <a href="?lng=fi">Suomi</a>
        </div>
        <h1><%= t('case') %>: <%= report.title %></h1>
        <p><strong><%= t('status') %>:</strong> <%= report.status %></p>
        <p><strong><%= t('description') %>:</strong> <%= report.description %></p>

        <div class="timeline">
            <h3><%= t('timeline') %></h3>
            <% const createdAt = new Date(report.created_at); %>
            <% const ackDeadline = new Date(createdAt); ackDeadline.setDate(createdAt.getDate() + 7); %>
            <% const resDeadline = new Date(createdAt); resDeadline.setMonth(createdAt.getMonth() + 3); %>
            <p><strong><%= t('acknowledge_deadline') %>:</strong> <%= ackDeadline.toLocaleString() %></p>
            <% if (report.acknowledged_at) { %>
                <p><strong><%= t('acknowledged_at') %>:</strong> <%= new Date(report.acknowledged_at).toLocaleString() %></p>
            <% } %>
            <p><strong><%= t('respond_deadline') %>:</strong> <%= resDeadline.toLocaleString() %></p>
            <% if (report.responded_at) { %>
                <p><strong><%= t('responded_at') %>:</strong> <%= new Date(report.responded_at).toLocaleString() %></p>
            <% } %>
        </div>

        <hr>

        <h2><%= t('communication_channel') %></h2>
        <div class="chat-box">
            <% messages.forEach(message => { %>
                <div class="message <%= message.sender %>">
                    <p><strong><%= message.sender %>:</strong> <%= message.message %></p>
                </div>
            <% }) %>
        </div>

        <form action="/case/<%= report.id %>/messages" method="POST" class="form-group">
            <input type="hidden" name="userType" value="<%= userType %>">
            <textarea name="message" rows="5" placeholder="<%= t('type_your_message') %>"></textarea>
            <br>
            <% if (userType === 'handler') { %>
                <input type="checkbox" name="is_acknowledgement" id="is_acknowledgement">
                <label for="is_acknowledgement"><%= t('is_acknowledgement') %></label>
                <br>
                <input type="checkbox" name="is_response" id="is_response">
                <label for="is_response"><%= t('is_response') %></label>
                <br>
            <% } %>
            <button type="submit" class="btn"><%= t('send_message') %></button>
        </form>
    </div>
</body>
</html>
