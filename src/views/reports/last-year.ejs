<!DOCTYPE html>
<html lang="<%= i18n.language %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= t('last_year_report') %></title>
    <style>
        body { font-family: sans-serif; line-height: 1.6; padding: 20px; }
        table { width: 100%; border-collapse: collapse; }
        th, td { border: 1px solid #ccc; padding: 8px; text-align: left; }
    </style>
</head>
<body>
    <h1><%= t('last_year_report') %></h1>

    <table>
        <thead>
            <tr>
                <th><%= t('case_title') %></th>
                <th><%= t('status') %></th>
                <th><%= t('created_at') %></th>
                <th><%= t('closed_at') %></th>
            </tr>
        </thead>
        <tbody>
            <% reports.forEach(report => { %>
                <tr>
                    <td><%= report.title %></td>
                    <td><%= report.status %></td>
                    <td><%= new Date(report.created_at).toLocaleString() %></td>
                    <td><%= report.closed_at ? new Date(report.closed_at).toLocaleString() : 'N/A' %></td>
                </tr>
            <% }) %>
        </tbody>
    </table>
</body>
</html>
