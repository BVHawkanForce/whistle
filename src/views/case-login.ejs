<!DOCTYPE html>
<html lang="<%= i18n.language %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= t('access_case') %></title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <div class="container">
        <div class="lang-switcher">
            <a href="?lng=en">English</a> | <a href="?lng=sv">Svenska</a> | <a href="?lng=fi">Suomi</a>
        </div>
        <h1><%= t('access_case') %></h1>
        <form action="/case" method="GET" class="form-group">
            <label for="code"><%= t('enter_your_code') %></label>
            <input type="text" id="code" name="code" required>
            <button type="submit" class="btn"><%= t('view_case') %></button>
        </form>
        <div class="admin-login">
            <a href="/admin/login"><%= t('admin_login') %></a>
        </div>
    </div>
</body>
</html>
